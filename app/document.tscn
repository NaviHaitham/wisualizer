[connection signal="close_requested" from="Model" to="." method="close"]
[connection signal="input_event" from="Model/Turntable/Grab" to="." method="turn_by_drag"]
[connection signal="pressed" from="Model/Options/Bar/Reset" to="." method="reset_turn"]
[connection signal="pressed" from="Model/Options/Bar/EditLabels" to="." method="edit_labels"]
[connection signal="resized" from="Model/Volume" to="." method="fit" unbinds=1]
[connection signal="pressed" from="Model/Controls/Bar/Play" to="." method="toggle_play"]
[connection signal="value_changed" from="Model/Controls/Bar/Frame" to="." method="seek"]
