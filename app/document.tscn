[connection signal="toggled" from="Model/Options/Bar/ShowLabels" to="Model/Turntable/Labels" method="set_visible"]
[connection signal="toggled" from="Model/Controls/Bar/NotesButton" to="." method="show_notes"]
[connection signal="close_requested" from="Model/Notes" to="." method="close_notes"]
[connection signal="meta_clicked" from="Model/Notes/Margin/Text" to="." method="open_link"]
[connection signal="toggled" from="Model/Controls/Bar/OptionsButton" to="." method="show_options"]
